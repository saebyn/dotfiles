{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "type": "remote",
    "url": "http://localhost:9876",
    "enabled": true
  },

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6": {
          "name": "Qwen3.6"
        }
      }
    }
  }
}
