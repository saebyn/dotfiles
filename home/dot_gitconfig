[init]
	defaultBranch = main

[user]
	name = saebyn
	email = "me@saebyn.dev"

[pull]
	rebase = true
[core]
	editor = nvim
[credential "https://github.com"]
	helper = 
	helper = !/etc/profiles/per-user/saebyn/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/etc/profiles/per-user/saebyn/bin/gh auth git-credential
[push]
	autoSetupRemote = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
